# ---------- Модели (нужен хотя бы один провайдер) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium

# Gemini через Google Cloud (ключ API из Agent Platform / Vertex AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Кто что делает: openai | gemini | groq
CRITERIA_PROVIDER=openai
ANNOTATION_PROVIDER=gemini
TEMPERATURE=0

# Цены для счётчика стоимости, $ за 1M токенов (вход,выход) — переопределяют встроенные
# PRICE_GPT_6_1_SOL=2,10
# PRICE_GEMINI_3_8_FLASH=0.375,1.875

# ---------- Данные организаторов ----------
# Ссылка GET из задания (group_id можно не указывать — подставляется отдельно)
CQA_API_URL=
DEFAULT_GROUP_ID=DEV

# ---------- Сервер ----------
PORT=8000
DB_PATH=./data/cqa.db
BATCH_CONCURRENCY=8
